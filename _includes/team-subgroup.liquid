<div class="team-subgroup subgroup-card">
  {% if include.title %}
    <h4>{{ include.title }}</h4>
  {% endif %}
  <ul class="member-list">
    {% comment %}Render subgroup leaders first, regardless of their order in the data file.{% endcomment %}
    {% for member in site.data.team.members %}
      {% for assignment in member.assignments %}
        {% if assignment.subgroup == include.subgroup and assignment.role == 'Leader' and assignment.auxiliary != true %}
          <li>
            {% include team-member-trigger.liquid member=member assignment=assignment variant="list" %}
          </li>
        {% endif %}
      {% endfor %}
    {% endfor %}
    {% comment %}Render primary members before auxiliary participants.{% endcomment %}
    {% for member in site.data.team.members %}
      {% for assignment in member.assignments %}
        {% if assignment.subgroup == include.subgroup and assignment.role != 'Leader' and assignment.auxiliary != true %}
          <li>
            {% include team-member-trigger.liquid member=member assignment=assignment variant="list" %}
          </li>
        {% endif %}
      {% endfor %}
    {% endfor %}
    {% for member in site.data.team.members %}
      {% for assignment in member.assignments %}
        {% if assignment.subgroup == include.subgroup and assignment.auxiliary == true %}
          <li class="support">
            {% include team-member-trigger.liquid member=member assignment=assignment variant="list" %}
          </li>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </ul>
</div>
